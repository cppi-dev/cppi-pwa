# Cloudflare Pages 응답 헤더
# HTML·XML 의 cache-control 은 functions/ 쪽 코드가 직접 설정한다(HTML 300s, sitemap 3600s).
# 여기서는 (1) 정적 자산 장기 캐시 (2) 버전 없는 진입 스크립트의 캐시 금지 (3) 보안 헤더를 담당한다.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# 파일명에 해시가 없는 진입 스크립트.
# 장기 캐시를 걸면 배포해도 사용자가 구버전 앱에 갇힌다. 반드시 매번 검증시킨다.
/app.js
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=3600

# 교체 시 파일명이 바뀌는 자산 - 1년 immutable
/img/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=31536000, immutable

/covers/*
  Cache-Control: public, max-age=31536000, immutable

/masters/*
  Cache-Control: public, max-age=31536000, immutable

/props/*
  Cache-Control: public, max-age=31536000, immutable

/reviews/*
  Cache-Control: public, max-age=31536000, immutable

/books/*
  Cache-Control: public, max-age=31536000, immutable

# 루트 미디어 - 히어로 영상과 로고는 교체 빈도가 낮다
/*.mp4
  Cache-Control: public, max-age=2592000

/*.jpg
  Cache-Control: public, max-age=2592000

/*.png
  Cache-Control: public, max-age=2592000

/favicon.ico
  Cache-Control: public, max-age=2592000
